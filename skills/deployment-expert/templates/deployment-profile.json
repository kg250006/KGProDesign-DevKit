{
  "$schema": "https://kgprodesign.dev/schemas/deployment-profile.json",
  "version": "1.0",
  "name": "{{PROJECT_NAME}}",
  "created": "{{TIMESTAMP}}",
  "lastDeploy": null,

  "platform": "{{PLATFORM}}",

  "build": {
    "command": "npm run build",
    "output": "dist",
    "environment": {
      "NODE_ENV": "production"
    },
    "nodeVersion": "20"
  },

  "envVars": {
    "required": [],
    "optional": [],
    "source": ".env.production",
    "publicPrefix": ["NEXT_PUBLIC_", "VITE_"]
  },

  "verification": {
    "url": "{{SITE_URL}}",
    "healthEndpoint": "/api/health",
    "expectedStatus": 200,
    "timeout": 30
  },

  "corporateAccessibility": {
    "customDomainRequired": true,
    "securityHeadersApplied": false,
    "fontsSelfHosted": false,
    "corporateVerified": false,
    "lastVerifiedAt": null,

    "overallStatus": "pending",
    "detectedStack": null,
    "detectedHost": null,
    "lastRunAt": null,

    "mitigations": {
      "M1": { "verdict": "pending", "detail": null },
      "M2": { "verdict": "pending", "detail": null },
      "M3": { "verdict": "pending", "detail": null },
      "M4": { "verdict": "pending", "detail": null },
      "M5": { "verdict": "pending", "detail": null },
      "M6": { "verdict": "pending", "detail": null },
      "M7": { "verdict": "pending", "detail": null }
    },

    "externalResourceAllowlist": [
      {
        "host": "example-payment-provider.com",
        "resourceType": "payment",
        "disposition": "allowlisted",
        "reason": "Required payment iframe — cannot be self-hosted (example entry; remove or replace)."
      }
    ],

    "vendorLedger": [
      {
        "vendor": "zscaler",
        "tier": "tier-2-gated",
        "currentCategory": null,
        "suggestedCategory": "Business/Professional Services",
        "status": "skipped",
        "submittedAt": null,
        "reference": null
      }
    ]
  },

  "scripts": {
    "preDeploy": null,
    "deploy": null,
    "postDeploy": null,
    "rollback": null
  },

  "notifications": {
    "slack": null,
    "email": null
  },

  "history": []
}
